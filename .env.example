# Copy to .env.local and fill in.

# Public address of the site (no trailing slash) — used for canonical/hreflang/OG.
NEXT_PUBLIC_SITE_URL=https://example.ru

# Yandex.Metrika counter number. Leave empty to disable analytics.
# In Metrika create a goal of type "JavaScript-событие" with id: lead_form_submit
NEXT_PUBLIC_YM_ID=

# Telegram bot (create via @BotFather). CHAT_ID: your user id, or a group id
# (negative number, bot must be a member). Several ids: comma separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: relay base url if api.telegram.org is blocked on your hosting.
# TELEGRAM_API_BASE=https://your-relay.example.com

# Optional second channel: this URL receives every lead as JSON (CRM, n8n, Albato,
# Google Apps Script...). Recommended, because Telegram is unstable in Russia.
# LEAD_WEBHOOK_URL=

# Optional: set to 1 on a demo deployment without a bot — the form then shows
# "thank you" and prints the lead to the server log instead of failing.
# LEAD_DEMO_MODE=1

# Lead journal: every lead is first written here (on the site's server, which must be
# located in Russia — ч. 5 ст. 18 152-ФЗ) and only then forwarded to Telegram.
# Default: ./data/leads.jsonl. Entries older than 6 months are removed automatically.
# LEAD_JOURNAL_PATH=/var/lib/glossa/leads.jsonl
